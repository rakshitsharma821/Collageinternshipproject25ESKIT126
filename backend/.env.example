# ==============================================================================
# GadgetVerse Backend — Environment Configuration (.env)
# ==============================================================================
# Configure these variables in Render Dashboard under Environment Variables.
# NEVER commit the real .env file or expose service role keys to frontend.
# ==============================================================================

# Server Network Configuration (Render automatically sets PORT)
PORT=3000
NODE_ENV=production

# Frontend Origin for CORS security
# Set to your Vercel deployment URL (e.g., https://your-project.vercel.app)
# Use * for development or during initial setup.
CORS_ORIGIN=https://your-frontend.vercel.app

# Supabase Database Configuration
# Obtain from Supabase Project Settings -> API
# Keep placeholders here; use the ignored project-root .env for local credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key_here
# Alternative secret-key variable name if that is what your project provides.
# SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Amazon India Creators API; requires approved Amazon Associates/Creators API access.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=

# Direct product-page checks are off by default. Set a retailer flag to true only
# after independently confirming automated access is permitted for your use.
AMAZON_PRODUCT_PAGE_ACCESS_AUTHORIZED=false
FLIPKART_PRODUCT_PAGE_ACCESS_AUTHORIZED=false
CROMA_PRODUCT_PAGE_ACCESS_AUTHORIZED=false
RELIANCE_DIGITAL_PRODUCT_PAGE_ACCESS_AUTHORIZED=false

# Email delivery for the scheduled alert worker (optional)
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Flipkart, Croma, and Reliance Digital have no active authorized product-data connector.
