              "raw": "{{baseUrl}}/api/gadgets?category=phone",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gadgets"],
              "query": [{ "key": "category", "value": "phone" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Invalid Category (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gadgets?category=invalid-category",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gadgets"],
              "query": [{ "key": "category", "value": "invalid-category" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Shopping Assistant (/api/assistant)",
      "item": [
        {
          "name": "Extract Criteria from Prompt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assistant?q=phone under 30000 with good battery",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assistant"],
              "query": [{ "key": "q", "value": "phone under 30000 with good battery" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Criteria parsed accurately', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.parsedCriteria.budgetMax).to.eql(30000);",
                  "  pm.expect(json.parsedCriteria.category).to.eql('phone');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Empty Assistant Query (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assistant?q=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assistant"],
              "query": [{ "key": "q", "value": "" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
