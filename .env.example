# ==============================================================================
# GadgetVerse — Master Environment Template (.env.example)
# ==============================================================================
# This template documents environment variables across Vercel, Render, and Supabase.
# DO NOT store real credentials in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (Backend Web Service)
# ------------------------------------------------------------------------------
# Root Directory on Render: backend
# Build Command: npm install
# Start Command: npm start
#
# Render automatically sets PORT.
PORT=3000
NODE_ENV=production

# Frontend Origin for CORS protection (Set to your Vercel deployment URL)
CORS_ORIGIN=https://your-project.vercel.app

# Supabase credentials (server-side only; obtain from Project Settings -> API)
# Keep placeholders here. For local development, copy this template to the ignored
# project-root .env file and place real values only in that .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# Alternative accepted by the backend if your project provides this name:
# SUPABASE_SECRET_KEY=your_supabase_secret_key

# Amazon India Creators API; requires approved Associates and Creators API access.
# Keep these values on the backend only.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=

# Direct product-page checks are off by default. Set a retailer flag to true only
# after independently confirming automated access is permitted for your use.
AMAZON_PRODUCT_PAGE_ACCESS_AUTHORIZED=false
FLIPKART_PRODUCT_PAGE_ACCESS_AUTHORIZED=false
CROMA_PRODUCT_PAGE_ACCESS_AUTHORIZED=false
RELIANCE_DIGITAL_PRODUCT_PAGE_ACCESS_AUTHORIZED=false

# Email delivery for the scheduled alert worker (optional)
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 2. VERCEL (Frontend Static Site)
# ------------------------------------------------------------------------------
# Root Directory on Vercel: frontend
# Build Command: None (Static HTML/CSS/JS)
# Output Directory: None
#
# To connect to Render backend directly, either:
# Option A: Set <meta name="api-base" content="https://your-backend.onrender.com"> in frontend HTML files
# Option B: Set window.GADGETVERSE_API_URL = "https://your-backend.onrender.com"
# Option C: Use vercel.json rewrites to proxy /api/:match* to your Render URL.
