# ==============================================================================
# GadgetVerse — Environment Configuration Template
# Copy to .env or configure in Netlify Site Configuration > Environment variables.
# NEVER commit production secrets or service-role keys to public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# Base Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# Public Browser-Safe Anonymous Key
SUPABASE_ANON_KEY="your-anon-publishable-key"

# Admin Service-Role Key (SERVER-ONLY - Never expose to browser/client-side code)
# Used strictly for server-side migrations and seed operations
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Retailer Integration Credentials (Server-Only)
# ------------------------------------------------------------------------------
# Amazon Product Advertising API (PA-API v5)
AMAZON_ACCESS_KEY="your-amazon-paapi-access-key"
AMAZON_SECRET_KEY="your-amazon-paapi-secret-key"
AMAZON_PARTNER_TAG="your-amazon-partner-tag-21"

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID="your-flipkart-affiliate-id"
FLIPKART_AFFILIATE_TOKEN="your-flipkart-affiliate-token"

# Croma Enterprise Partner API
CROMA_API_KEY="your-croma-partner-api-key"

# ------------------------------------------------------------------------------
# 3. Optional AI Provider Configuration (Server-Only)
# ------------------------------------------------------------------------------
# Gemini API Key for enhanced natural language shopping assistant synthesis
GEMINI_API_KEY="your-gemini-api-key"
